PORT=5001
NODE_ENV=development

# PostgreSQL connection string. Leave empty to use the embedded SQLite database.
DATABASE_URL=

# Required: at least 32 random characters (e.g. `openssl rand -hex 32`). The server refuses to start without it.
JWT_SECRET=
# 32-byte key used for AES-256-GCM encryption of stored OAuth tokens
ENCRYPTION_KEY=

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
FRONTEND_URL=http://localhost:3000
DEFAULT_SPREADSHEET_ID=
